<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{title}}</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; line-height: 1.5; }
  textarea { width: 100%; font: inherit; padding: 0.5rem; box-sizing: border-box; }
  label { font-weight: 600; display: block; margin-top: 1rem; }
  button { padding: 0.5rem 1.25rem; margin-top: 0.75rem; cursor: pointer; border: 1px solid #333; background: #1a1a1a; color: #fff; border-radius: 4px; }
  button:focus-visible { outline: 3px solid #2f6fdb; outline-offset: 2px; }
  button.secondary { background: #fff; color: #1a1a1a; }
  output { display: block; background: #f4f4f4; padding: 1rem; white-space: pre-wrap; border-radius: 4px; min-height: 1.5rem; font-family: ui-monospace, monospace; }
  .limits { font-size: 0.9rem; color: #444; border-top: 1px solid #ddd; margin-top: 2rem; padding-top: 1rem; }
</style>
</head>
<body>
  <main>
    <h1>{{title}}</h1>
    <p>{{hook}} Runs entirely in your browser.</p>
    <label for="text">Input</label>
    <textarea id="text" rows="4">one two three four five six</textarea>
    <button id="run" type="button">Run</button>
    <output id="output" aria-live="polite"></output>
    <button id="run-eval" type="button" class="secondary">Run evaluation</button>
    <output id="eval-output" aria-live="polite"></output>
    <section class="limits" aria-label="Known limitations">
      <strong>Known limitations:</strong> TODO. See the project <a href="../README.md">README</a>.
    </section>
  </main>
  <script type="module" src="./dist/main.js"></script>
</body>
</html>
